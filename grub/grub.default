# /etc/default/grub — managed by arch-install/install.sh
# __NVIDIA_CMDLINE__ is replaced by install.sh:
#   default (AMD/Intel): empty string
#   --nvidia flag:       nvidia-drm.modeset=1

GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="Arch"
GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet __NVIDIA_CMDLINE__"
GRUB_CMDLINE_LINUX=""

GRUB_PRELOAD_MODULES="part_gpt part_msdos"

#GRUB_ENABLE_CRYPTODISK=y

GRUB_TIMEOUT_STYLE=menu
GRUB_TERMINAL_INPUT=console

GRUB_GFXMODE=2560x1440
GRUB_GFXPAYLOAD_LINUX=keep

GRUB_DISABLE_RECOVERY=true

GRUB_THEME="/boot/grub/themes/yorha/theme.txt"

#GRUB_SAVEDEFAULT=true
#GRUB_DISABLE_SUBMENU=y
#GRUB_DISABLE_OS_PROBER=false
